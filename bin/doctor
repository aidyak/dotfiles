#!/bin/bash

pass=0
fail=0

check() {
  if eval "$2" &>/dev/null; then
    echo "  ✓ $1"
    ((pass++))
  else
    echo "  ✗ $1"
    ((fail++))
  fi
}

echo "==> Checking environment..."

check "Homebrew installed" "command -v brew"
check "mise installed" "command -v mise"
check "Spaceship prompt available" "test -f $(brew --prefix 2>/dev/null)/opt/spaceship/spaceship.zsh"
check "zsh-syntax-highlighting installed" "test -d $(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting"
check "zsh-autosuggestions installed" "test -d $(brew --prefix 2>/dev/null)/share/zsh-autosuggestions"
check "Catppuccin theme installed" "test -d $HOME/.zsh/catppuccin-zsh-syntax-highlighting"
check "FiraCode Nerd Font installed" "ls ~/Library/Fonts/FiraCode*Nerd* 2>/dev/null || ls /Library/Fonts/FiraCode*Nerd* 2>/dev/null"

if ls ~/Library/Fonts/MonoLisaNerd* &>/dev/null 2>&1 || ls ~/Library/Fonts/*MonoLisa*Nerd* &>/dev/null 2>&1; then
  echo "  ✓ MonoLisa Nerd Font installed (preferred)"
  ((pass++))
else
  echo "  · MonoLisa Nerd Font not found (using FiraCode as fallback)"
fi

echo ""
echo "==> Language toolchains..."

check "Ruby available" "mise which ruby"
check "Go available" "mise which go"
check "Node available" "mise which node"
check "Java available" "mise which java"
check "Rust available" "mise which rustc"

echo ""
echo "==> Dotfile symlinks..."

check "~/.zshrc linked" "test -L $HOME/.zshrc"
check "~/.zshenv linked" "test -L $HOME/.zshenv"
check "~/.gitconfig linked" "test -L $HOME/.gitconfig"
check "~/.config/mise/config.toml linked" "test -L $HOME/.config/mise/config.toml"
check "Ghostty config linked" "test -L '$HOME/Library/Application Support/com.mitchellh.ghostty/config'"
check "Ghostty installed" "ls /Applications/Ghostty.app &>/dev/null || command -v ghostty"

echo ""
echo "==> CLI tools..."

check "delta installed" "command -v delta"
check "fzf installed" "command -v fzf"
check "fd installed" "command -v fd"
check "bat installed" "command -v bat"
check "lazygit installed" "command -v lazygit"
check "gh installed" "command -v gh"
check "gh-dash extension" "gh extension list | grep -q gh-dash"
check "gh-notify extension" "gh extension list | grep -q gh-notify"
check "gh-copilot extension" "gh extension list | grep -q gh-copilot"

echo ""
echo "==> Apps..."

check "Raycast installed" "ls /Applications/Raycast.app &>/dev/null"
check "1Password CLI installed" "command -v op"
check "Docker installed" "command -v docker"
check "VS Code installed" "command -v code"

echo ""
echo "==> Results: $pass passed, $fail failed"

if [[ $fail -gt 0 ]]; then
  echo "    Run 'bin/setup' to fix issues."
fi

# --- Workspace staleness ---
DEV_DIR="$HOME/dev"
STALE_MONTHS=6
cutoff=$(date -v-${STALE_MONTHS}m +%s 2>/dev/null || date -d "$STALE_MONTHS months ago" +%s)
stale=0

for dir in "$DEV_DIR"/*/; do
  name=$(basename "$dir")
  [[ "$name" == "_archive" || "$name" == "dotfiles" ]] && continue
  if [[ -d "$dir/.git" ]]; then
    last_epoch=$(git -C "$dir" log -1 --format=%ct 2>/dev/null || echo 0)
    [[ $last_epoch -lt $cutoff ]] && ((stale++))
  fi
done

if [[ $stale -gt 0 ]]; then
  echo ""
  echo "==> Workspace: $stale stale projects (no commits in ${STALE_MONTHS}+ months)"
  echo "    Run 'ws archive' to clean up."
fi

[[ $fail -gt 0 ]] && exit 1 || exit 0
