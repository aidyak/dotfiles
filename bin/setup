#!/bin/bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "===> Start setup..."

# --- Homebrew ---
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  echo "==> Homebrew already installed"
fi

# --- Trust third-party taps ---
# yabai/skhd は koekeishiya/formulae という非公式 tap から入れるため、
# 未信頼だと `brew bundle` が "Refusing to load formula from untrusted tap" で失敗する。
if brew trust --json=v1 2>/dev/null | grep -q "koekeishiya/formulae"; then
  echo "==> koekeishiya/formulae tap already trusted"
else
  echo "==> Trusting koekeishiya/formulae tap..."
  brew trust --taps koekeishiya/formulae
fi

# --- Homebrew packages ---
echo "===> Installing Homebrew packages..."
brew bundle --file="$DOTFILES_DIR/Brewfile"

# --- Catppuccin syntax highlighting theme ---
CATPPUCCIN_DIR="$HOME/.zsh/catppuccin-zsh-syntax-highlighting"
if [[ ! -d "$CATPPUCCIN_DIR" ]]; then
  echo "==> Installing Catppuccin Macchiato syntax highlighting theme..."
  mkdir -p "$HOME/.zsh"
  git clone --depth=1 https://github.com/catppuccin/zsh-syntax-highlighting.git "$CATPPUCCIN_DIR"
else
  echo "==> Catppuccin theme already installed"
fi

# --- Symlink dotfiles ---
echo "==> Linking dotfiles..."
"$DOTFILES_DIR/bin/install"

if [[ "$(uname)" == "Darwin" ]]; then
  # --- macOS defaults ---
  echo "==> Applying macOS defaults..."
  "$DOTFILES_DIR/bin/macos-defaults.swift"

  # --- yabai / skhd services ---
  # --start-service は LaunchAgent の plist を生成して launchctl load するので、
  # 既にインストール済みなら plist の有無で判定してスキップする。
  if [[ -f "$HOME/Library/LaunchAgents/com.asmvik.yabai.plist" ]]; then
    echo "==> yabai service already installed"
  else
    echo "==> Starting yabai service..."
    yabai --start-service
  fi

  if [[ -f "$HOME/Library/LaunchAgents/com.koekeishiya.skhd.plist" ]]; then
    echo "==> skhd service already installed"
  else
    echo "==> Starting skhd service..."
    skhd --start-service
  fi
fi

# --- Install mise tools ---
echo "==> Installing mise-managed tools..."
mise use --global ruby@latest go@latest node@latest rust@latest
mise install

# --- GitHub CLI extensions ---
echo "==> Installing gh extensions..."
gh extension install dlvhdr/gh-dash 2>/dev/null || true
gh extension install meiji163/gh-notify 2>/dev/null || true
gh extension install github/gh-copilot 2>/dev/null || true

echo ""
echo "==> Setup complete!"
echo "    Restart your shell or run: exec zsh"
echo "    Terminal font: 'FiraCode Nerd Font' (install MonoLisa + Docker to patch)"
echo ""
