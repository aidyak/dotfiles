#!/bin/bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$DOTFILES_DIR/zshenv"

link() {
  local src="$1"
  local dst="$2"
  if [[ -e "$dst" && ! -L "$dst" ]]; then
    echo "  Backing up $dst -> ${dst}.bak"
    mv "$dst" "${dst}.bak"
  fi
  ln -sfn "$src" "$dst"
  echo "  $dst -> $src"
}

echo "==> Linking dotfiles..."

if ! command -v python3 &>/dev/null || ! python3 -c 'import tomllib' 2>/dev/null; then
  echo "Python 3.11+ is required for AI settings. Install it before running bin/install." >&2
  exit 1
fi

link "$DOTFILES_DIR/zshrc" "$HOME/.zshrc"
link "$DOTFILES_DIR/zshenv" "$HOME/.zshenv"

mkdir -p "$XDG_CONFIG_HOME/mise"
link "$DOTFILES_DIR/config/mise/config.toml" "$XDG_CONFIG_HOME/mise/config.toml"

mkdir -p "$HOME/Library/Application Support/com.mitchellh.ghostty"
link "$DOTFILES_DIR/config/ghostty/config" "$HOME/Library/Application Support/com.mitchellh.ghostty/config"

mkdir -p "$XDG_CONFIG_HOME/alacritty"
link "$DOTFILES_DIR/config/alacritty/alacritty.toml" "$XDG_CONFIG_HOME/alacritty/alacritty.toml"

link "$DOTFILES_DIR/gitconfig" "$HOME/.gitconfig"

link "$DOTFILES_DIR/config/nvim" "$XDG_CONFIG_HOME/nvim"

echo "==> Syncing AI settings..."
"$DOTFILES_DIR/bin/sync-ai"

if [[ "$(uname)" == "Darwin" ]]; then
  echo "==> Applying Karabiner settings..."
  "$DOTFILES_DIR/bin/setup-karabiner"
fi

echo "==> Done."
