#!/usr/bin/env python3
"""Sync portable AI settings while preserving local settings and integrations."""
import argparse
import copy
import json
import os
from pathlib import Path
import re
import tempfile
import tomllib
from datetime import datetime

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "config/ai"


def merge(current, managed):
    if isinstance(current, dict) and isinstance(managed, dict):
        result = copy.deepcopy(current)
        for key, value in managed.items():
            result[key] = merge(result[key], value) if key in result else value
        return result
    if isinstance(current, list) and isinstance(managed, list):
        return current + [value for value in managed if value not in current]
    return managed


def merge_toml(current, managed):
    """Replace managed root assignments, retaining every local table verbatim."""
    parsed = tomllib.loads(current)
    defaults = tomllib.loads(managed)
    if any(isinstance(value, dict) for value in defaults.values()):
        raise ValueError("Managed Codex config must contain top-level values only")
    if all(key in parsed and parsed[key] == value for key, value in defaults.items()):
        return current
    lines = current.splitlines(keepends=True)
    # Root arrays can span lines beginning with '['; locate tables by their header.
    for i, line in enumerate(lines):
        if re.match(r'^\s*\[\[?[^\[\]\n]+\]\]?\s*(?:#.*)?$', line):
            table_start = i
            break
    else:
        table_start = len(lines)
    root_text = "".join(lines[:table_start])
    assignments = list(re.finditer(r'^([A-Za-z0-9_-]+)\s*=', root_text, re.M))
    for index in range(len(assignments) - 1, -1, -1):
        match = assignments[index]
        if match.group(1) in defaults:
            end = assignments[index + 1].start() if index + 1 < len(assignments) else len(root_text)
            root_text = root_text[:match.start()] + root_text[end:]
    result = managed.rstrip() + "\n\n" + root_text + "".join(lines[table_start:])
    expected = {**parsed, **defaults}
    if tomllib.loads(result) != expected:
        raise ValueError("Codex merge would change unmanaged settings")
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Preview changes without writing")
    parser.add_argument("--home", type=Path, default=Path.home(), help="Target home (also useful for verification)")
    args = parser.parse_args()
    home = args.home.expanduser().resolve()
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    plans = []

    def write(path, content, mode=0o600):
        if path.exists() and not path.is_file():
            raise ValueError(f"Expected a file: {path}")
        if path.is_file() and path.read_text() == content:
            return
        plans.append(("write", path, content, mode))

    def link(path, target):
        if path.is_symlink() and path.resolve() == target.resolve():
            return
        plans.append(("link", path, target, None))

    for agent, filename in [("claude", "CLAUDE.md"), ("codex", "AGENTS.md")]:
        content = "\n\n".join((SOURCE / "instructions" / name).read_text().strip()
                              for name in ["common.md", f"{agent}.md"])
        write(home / f".{agent}" / filename,
              "<!-- Generated by dotfiles/bin/sync-ai; edit config/ai/instructions instead. -->\n\n" + content.rstrip() + "\n")

    claude_path = home / ".claude/settings.json"
    current = json.loads(claude_path.read_text()) if claude_path.exists() else {}
    managed = json.loads((SOURCE / "claude/settings.json").read_text())
    write(claude_path, json.dumps(merge(current, managed), ensure_ascii=False, indent=2) + "\n")
    codex_path = home / ".codex/config.toml"
    current = codex_path.read_text() if codex_path.exists() else ""
    managed = (SOURCE / "codex/config.toml").read_text().replace("@HOME@", str(home))
    write(codex_path, merge_toml(current, managed))

    for agent, names in [("claude", ["statusline.sh", "hooks/pre-commit-check.sh", "hooks/run_changed_specs.sh"]),
                         ("codex", ["notify_macos.sh"])]:
        for name in names:
            link(home / f".{agent}" / name, SOURCE / agent / name)

    for skill in sorted((SOURCE / "skills").iterdir()):
        if not skill.is_dir() or not (skill / "SKILL.md").is_file():
            continue
        for folder in [".claude/skills", ".agents/skills"]:
            link(home / folder / skill.name, skill)
        # Retire the legacy copy to avoid discovering the same skill twice.
        legacy = home / ".codex/skills" / skill.name
        if legacy.exists() or legacy.is_symlink():
            plans.append(("retire", legacy, None, None))

    # Validate all configuration before changing any files. No secret values printed.
    for action, path, content, mode in plans:
        print(f"{action}: {path}")
        if args.check:
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists() or path.is_symlink():
            backup = home / ".local/state/dotfiles-ai/backups" / stamp / path.relative_to(home)
            backup.parent.mkdir(parents=True, exist_ok=True)
            path.rename(backup)
        if action == "link":
            path.symlink_to(content, target_is_directory=content.is_dir())
        elif action == "write":
            descriptor, temporary = tempfile.mkstemp(prefix=".sync-ai-", dir=path.parent)
            try:
                with os.fdopen(descriptor, "w") as handle:
                    handle.write(content)
                os.chmod(temporary, mode)
                os.replace(temporary, path)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
    print(f"{'Planned' if args.check else 'Applied'} {len(plans)} changes.")


if __name__ == "__main__":
    main()
